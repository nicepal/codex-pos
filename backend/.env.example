NODE_ENV=development
HOST=0.0.0.0
PORT=5001
API_PREFIX=/api/v1

# Database
DATABASE_URL=postgresql://eyz_user:eyz_password@localhost:5555/eyz_pos
DB_HOST=localhost
DB_PORT=5555
DB_NAME=eyz_pos
DB_USER=eyz_user
DB_PASSWORD=eyz_password
DB_POOL_MIN=2
DB_POOL_MAX=20

# JWT
JWT_ACCESS_SECRET=your-super-secret-access-key-change-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Redis
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379

# App
APP_NAME=Codex POS
APP_URL=http://localhost:3000
API_URL=http://localhost:5001
PLATFORM_DOMAIN=codexpos.store
STOREFRONT_DOMAIN=codexpos.store

# SMTP
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@codexpos.store

# Storage (S3 / DigitalOcean Spaces)
STORAGE_PROVIDER=s3
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=eyz-pos
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Payment Gateways (configure as needed)
# Production defaults PAYMENT_PROVIDER=stripe. Stub confirm requires ALLOW_PAYMENT_STUB=true.
PAYMENT_PROVIDER=stub
ALLOW_PAYMENT_STUB=true
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
PAYMENT_WEBHOOK_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# SSO stub (non-production demos only; never create accounts from client email)
ALLOW_SSO_STUB=false

# Rate Limiting (global limiter is production-only; auth limiter always applies)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=2000
AUTH_RATE_LIMIT_MAX=20
