NODE_ENV=production
HOST=127.0.0.1
PORT=8510
API_PREFIX=/api/v1

# Database (Postgres stays on localhost; not in the public 8502–8900 range)
# Password in the URL is URL-encoded: @ → %40
DATABASE_URL=postgresql://poshive:codexpos%40123@127.0.0.1:5432/poshive_pos
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=poshive_pos
DB_USER=poshive
DB_PASSWORD=codexpos@123
DB_POOL_MIN=2
DB_POOL_MAX=20

# JWT — generate with: openssl rand -hex 32
JWT_ACCESS_SECRET=CHANGE_ME_64_PLUS_CHARS
JWT_REFRESH_SECRET=CHANGE_ME_64_PLUS_CHARS
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Redis (localhost only)
REDIS_URL=redis://127.0.0.1:6379
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# Public HTTPS origin (TLS terminates in front of Nginx :8502)
APP_NAME=Poshive
APP_URL=https://app.poshive.store
API_URL=https://poshive.store
PLATFORM_DOMAIN=poshive.store
STOREFRONT_DOMAIN=poshive.store

# SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@poshive.store

# Storage
STORAGE_PROVIDER=local
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=codexpos
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Payments — stub is blocked in production unless ALLOW_PAYMENT_STUB=true
PAYMENT_PROVIDER=stripe
ALLOW_PAYMENT_STUB=false
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
PAYMENT_WEBHOOK_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

ALLOW_SSO_STUB=false

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=2000
AUTH_RATE_LIMIT_MAX=20

UPLOAD_SIGNING_SECRET=CHANGE_ME
UPLOAD_URL_TTL_SECONDS=604800
REALTIME_ENABLED=true
